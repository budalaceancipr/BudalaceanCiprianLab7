<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="BudalaceanCiprianLab7.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:BudalaceanCiprianLab7"
    Shell.FlyoutBehavior="Disabled">

    <TabBar>
        <ShellContent
            Title="Home"
            ContentTemplate="{DataTemplate local:MainPage}" />

        <ShellContent
            Title="Clinics"
            ContentTemplate="{DataTemplate local:ClinicEntryPage}" />

        <ShellContent
            Title="Appointments"
            ContentTemplate="{DataTemplate local:AppointmentEntryPage}" />

        <ShellContent
            Title="Services"
            ContentTemplate="{DataTemplate local:ServiceEntryPage}" />

        <ShellContent
            Title="Appointment Services"
            ContentTemplate="{DataTemplate local:AppointmentServiceEntryPage}" />

        <ShellContent
            Title="About"
            ContentTemplate="{DataTemplate local:AboutPage}" />
    </TabBar>

    <Shell.FlyoutHeader>
        <StackLayout Padding="10">
            <Label Text="Clinic App" FontSize="24" />
            <Button Text="Logout" Clicked="OnLogoutClicked" />
        </StackLayout>
    </Shell.FlyoutHeader>

</Shell>
