<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="BudalaceanCiprianLab7.ServiceEntryPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Add Service">

    <StackLayout Padding="20" Spacing="15">

        <Label Text="Service Name" FontSize="Medium"/>
        <Entry x:Name="NameEntry" Placeholder="Enter service name"/>

        <Label Text="Price" FontSize="Medium"/>
        <Entry x:Name="PriceEntry" Placeholder="Enter price" Keyboard="Numeric"/>

        <Button Text="Save" Clicked="OnSaveClicked"/>
    </StackLayout>
</ContentPage>
