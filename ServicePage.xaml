<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BudalaceanCiprianLab7.ServicePage"
             Title="Services">

    <StackLayout Padding="10">
        <Label Text="Lista Servicii" 
               FontSize="24" 
               HorizontalOptions="Center" />

        <CollectionView x:Name="ServicesCollectionView"
                        SelectionMode="Single"
                        SelectionChanged="OnServiceSelected">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame BorderColor="Gray" CornerRadius="5" Padding="10" Margin="5">
                        <StackLayout>
                            <Label Text="{Binding Name}" FontSize="18"/>
                            <Label Text="{Binding Price, StringFormat='Pret: {0:C}'}" FontSize="14"/>
                        </StackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button Text="Adauga Serviciu" Clicked="OnAddServiceClicked" />
    </StackLayout>
</ContentPage>
